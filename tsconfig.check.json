{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@g2w/core": ["packages/core/src/index.ts"],
      "@g2w/input-dom": ["packages/input-dom/src/index.ts"],
