---
import "../styles/global.css";
import { LOCKUP_NAVBAR, MARK_ICON } from "../lib/marks";
import PixelMark from "../components/PixelMark.astro";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "g2w (Game to Website) is a TypeScript-first, AI-agent-ready framework for building and shipping HTML5 web games.",
} = Astro.props;

// Cache-busting query so social platforms re-fetch the image instead of
// serving a cached preview from before the asset existed. Bump on changes.
const ogImage = "/og.png?v=20261028";
const ogImageAlt = "g2w — Game to Website: pixel lockup of a gamepad, G 2 W, and a browser window";
const site = "https://g2w.alexanderar.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="g2w" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={site + ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site + ogImage} />
  </head>
  <body>
    <nav class="navbar">
      <div class="container navbar-inner">
        <a class="navbar-brand" href="/" aria-label="g2w home">
          <PixelMark grid={MARK_ICON} pixelSize={3} label="G2W pixel mark" />
        </a>
        <div class="navbar-links">
          <a href="/docs/introduction">Docs</a>
          <a href="/playground">Playground</a>
          <a href="/docs/roadmap">Roadmap</a>
          <a href="https://github.com/AlexanderDev2004/g2w/blob/main/ARCHITECTURE.md">Architecture</a>
          <a href="https://github.com/AlexanderDev2004/g2w/blob/main/CONTRIBUTING.md">Contributing</a>
        </div>
        <div class="navbar-right">
          <span class="version-badge">v0.1.0</span>
          <button class="nav-search" type="button" aria-label="Search the site (press Ctrl+K or /)">
            <span aria-hidden="true">⌕</span>
            <span class="nav-search-key">Ctrl K</span>
          </button>
          <a
            class="btn btn-sm nav-star"
            href="https://github.com/AlexanderDev2004/g2w/stargazers"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Star g2w on GitHub"
          >
            <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
              <path
                d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z"
              ></path>
            </svg>
            <span class="nav-star-count" data-github-stars>Star</span>
          </a>
          <a
            class="btn btn-sm btn-dark"
            href="https://github.com/AlexanderDev2004/g2w"
            aria-label="g2w on GitHub"
          >
            GitHub
          </a>
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label="Toggle navigation menu"
          >
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </button>
        </div>
        <div class="navbar-menu" id="site-menu">
          <a href="/docs/introduction">Docs</a>
          <a href="/playground">Playground</a>
          <a href="/docs/roadmap">Roadmap</a>
          <a href="https://github.com/AlexanderDev2004/g2w/blob/main/ARCHITECTURE.md">Architecture</a>
          <a href="https://github.com/AlexanderDev2004/g2w/blob/main/CONTRIBUTING.md">Contributing</a>
          <a href="https://github.com/AlexanderDev2004/g2w/stargazers">Star on GitHub</a>
        </div>
      </div>
    </nav>
    <slot />
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col" style="max-width: 320px">
            <PixelMark grid={LOCKUP_NAVBAR} pixelSize={3} ink="#f2efe6" label="G2W" />
            <p style="font-size: 13.5px; color: #a39e90; margin-top: 16px">
              A TypeScript-first, AI-agent-ready framework for building and shipping web
              games. MIT licensed.
            </p>
          </div>
          <div class="footer-col">
            <h3>Docs</h3>
            <a href="/docs/introduction">Introduction</a>
            <a href="/docs/installation">Installation</a>
            <a href="/docs/your-first-game">Your First Game</a>
            <a href="/docs/introduction#lifecycle">Game lifecycle</a>
            <a href="/playground">Playground</a>
          </div>
          <div class="footer-col">
            <h3>Project</h3>
            <a href="https://github.com/AlexanderDev2004/g2w">GitHub</a>
            <a href="/docs/roadmap">Roadmap</a>
            <a href="https://github.com/AlexanderDev2004/g2w/blob/main/CONTRIBUTING.md">Contributing</a>
          </div>
        </div>
        <div class="fine">
          <span>g2w — Game to Website</span>
          <span>MIT License · Built with Astro + React</span>
        </div>
      </div>
    </footer>
    <SearchModal />
    <script>
      const nav = document.querySelector(".navbar");
      const toggle = document.querySelector(".nav-toggle");
      toggle?.addEventListener("click", () => {
        const open = nav?.classList.toggle("menu-open") ?? false;
        toggle?.setAttribute("aria-expanded", String(open));
      });
      document.querySelectorAll(".navbar-menu a").forEach((link) => {
        link.addEventListener("click", () => {
          nav?.classList.remove("menu-open");
          toggle?.setAttribute("aria-expanded", "false");
        });
      });
      // Live star count; the static "Star" label stays when the API is
      // unreachable (offline, rate-limited, blocked).
      const starCount = document.querySelector("[data-github-stars]");
      if (starCount) {
        fetch("https://api.github.com/repos/AlexanderDev2004/g2w", {
          headers: { Accept: "application/vnd.github+json" },
        })
          .then((response) => (response.ok ? response.json() : null))
          .then((repo) => {
            if (!repo || typeof repo.stargazers_count !== "number") return;
            starCount.textContent = new Intl.NumberFormat("en", {
              notation: "compact",
              maximumFractionDigits: 1,
            }).format(repo.stargazers_count);
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
