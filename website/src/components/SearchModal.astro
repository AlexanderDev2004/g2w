---
// Site-wide search with keyboard shortcuts:
//   Ctrl+K / Cmd+K or "/" opens, Esc closes, ↑ ↓ navigate, Enter opens.
// The index is static and built at build time — no runtime dependency.
const index = [
  { title: "Home", url: "/", group: "Site", keywords: "g2w game to website framework typescript pixi html5", desc: "TypeScript-first, AI-agent-ready framework for building and shipping web games." },
  { title: "Playground", url: "/playground", group: "Site", keywords: "games demo community play ink-dash examples showcase", desc: "Games built by other developers with g2w — playable in the browser." },
  { title: "Introduction", url: "/docs/introduction", group: "Getting Started", keywords: "overview what is g2w architecture runtime lifecycle game loop frame states", desc: "What g2w is, its architecture, and the game lifecycle." },
  { title: "Installation", url: "/docs/installation", group: "Getting Started", keywords: "install setup npm pnpm create-g2w scaffold vite node requirements", desc: "Scaffold a game with create-g2w or add packages manually." },
  { title: "Your First Game", url: "/docs/your-first-game", group: "Getting Started", keywords: "tutorial first game scene sprite update loop beginner quickstart", desc: "A minimal playable game, step by step." },
  { title: "Scenes", url: "/docs/scenes", group: "Core Concepts", keywords: "scene manager SceneManager active transition register keys", desc: "Organize game states with the renderer-agnostic SceneManager." },
  { title: "Sprites & Transforms", url: "/docs/sprites-and-transforms", group: "Core Concepts", keywords: "sprite transform2d position rotation scale texture renderer pixi", desc: "The Transform2D/Sprite2D model and createSpriteView." },
  { title: "Input", url: "/docs/input", group: "Core Concepts", keywords: "keyboard pointer touch gamepad input state dom adapter", desc: "The DOM-free InputState and its browser adapters." },
  { title: "Audio", url: "/docs/audio", group: "Core Concepts", keywords: "sound music web audio volume playback backend", desc: "The AudioManager contract and the Web Audio backend." },
  { title: "Assets", url: "/docs/assets", group: "Core Concepts", keywords: "asset manager loader texture load progress", desc: "Load textures and other assets with the AssetManager." },
  { title: "Packages", url: "/docs/packages", group: "Packages", keywords: "monorepo core renderer-pixi input-dom input-gamepad audio-web runtime create-g2w npm", desc: "The small packages that compose g2w, and their dependency rules." },
  { title: "DevTools", url: "/docs/devtools", group: "Tooling", keywords: "devtools overlay debug inspector fps scenes objects transform input log development", desc: "The read-only runtime inspector: scenes, objects, FPS, input, and logs." },
];
---
<div class="search-modal" id="search-modal" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search the site">
    <div class="search-row">
      <span class="search-glyph" aria-hidden="true">⌕</span>
      <input
        class="search-input"
        id="search-input"
        type="text"
        placeholder="Search docs…"
        aria-label="Search docs"
        autocomplete="off"
        spellcheck="false"
      />
      <button class="search-esc" type="button" data-search-close aria-label="Close search">esc</button>
    </div>
    <ul class="search-results" id="search-results" role="listbox" aria-label="Search results"></ul>
    <div class="search-hint">
      <span><b>↑↓</b> navigate</span>
      <span><b>↵</b> open</span>
      <span><b>esc</b> close</span>
    </div>
  </div>
</div>

<script>
  const MODAL = document.getElementById("search-modal") as HTMLElement | null;
  const INPUT = document.getElementById("search-input") as HTMLInputElement | null;
  const LIST = document.getElementById("search-results") as HTMLElement | null;
  const TRIGGER = document.querySelector<HTMLButtonElement>(".nav-search");

  const INDEX = JSON.parse(
    document.getElementById("search-index")?.textContent ?? "[]",
  ) as { title: string; url: string; group: string; keywords: string; desc: string }[];

  let active = -1;
  let current: { title: string; url: string; group: string }[] = [];

  function openSearch(): void {
    if (!MODAL || MODAL.hidden === false) return;
    MODAL.hidden = false;
    document.body.style.overflow = "hidden";
    INPUT?.focus();
    INPUT?.select();
    runSearch();
  }

  function closeSearch(): void {
    if (!MODAL || MODAL.hidden) return;
    MODAL.hidden = true;
    document.body.style.overflow = "";
    if (INPUT) INPUT.value = "";
    active = -1;
    current = [];
  }

  function score(entry: (typeof INDEX)[number], query: string): number {
    const title = entry.title.toLowerCase();
    let points = 0;
    if (title.startsWith(query)) points += 3;
    else if (title.includes(query)) points += 2;
    if (entry.keywords.includes(query)) points += 1;
    if (entry.desc.toLowerCase().includes(query)) points += 0.5;
    return points;
  }

  function runSearch(): void {
    if (!LIST) return;
    const query = (INPUT?.value ?? "").trim().toLowerCase();
    current =
      query === ""
        ? INDEX
        : INDEX.map((entry) => ({ entry, points: score(entry, query) }))
            .filter((hit) => hit.points > 0)
            .sort((a, b) => b.points - a.points)
            .map((hit) => hit.entry);
    active = current.length > 0 ? 0 : -1;
    LIST.innerHTML = "";
    current.forEach((entry, i) => {
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", String(i === active));
      li.className = "search-item" + (i === active ? " on" : "");
      li.innerHTML = `<span class="search-group">${entry.group}</span><span class="search-title">${entry.title}</span><span class="search-desc">${entry.desc}</span>`;
      li.addEventListener("click", () => {
        location.href = entry.url;
      });
      li.addEventListener("mousemove", () => setActive(i));
      LIST.appendChild(li);
    });
    if (current.length === 0) {
      const li = document.createElement("li");
      li.className = "search-empty";
      li.textContent = `No results for “${INPUT?.value ?? ""}”`;
      LIST.appendChild(li);
    }
  }

  function setActive(index: number): void {
    if (!LIST) return;
    active = Math.max(0, Math.min(index, current.length - 1));
    LIST.querySelectorAll(".search-item").forEach((el, i) => {
      el.classList.toggle("on", i === active);
      el.setAttribute("aria-selected", String(i === active));
    });
    LIST.children[active]?.scrollIntoView({ block: "nearest" });
  }

  TRIGGER?.addEventListener("click", openSearch);
  document.querySelectorAll("[data-search-close]").forEach((el) => {
    el.addEventListener("click", closeSearch);
  });
  INPUT?.addEventListener("input", runSearch);

  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target?.tagName === "INPUT" ||
      target?.tagName === "TEXTAREA" ||
      target?.isContentEditable === true;

    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (MODAL?.hidden) openSearch();
      else closeSearch();
      return;
    }
    if (event.key === "/" && !typing && MODAL?.hidden) {
      event.preventDefault();
      openSearch();
      return;
    }
    if (MODAL?.hidden) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeSearch();
    } else if (event.key === "ArrowDown") {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === "Enter" && current[active]) {
      event.preventDefault();
      location.href = current[active].url;
    }
  });
</script>

<script type="application/json" id="search-index" set:html={JSON.stringify(index)} />

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 16px 16px;
  }
  .search-modal[hidden] {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(26, 23, 17, 0.55);
  }
  .search-panel {
    position: relative;
    width: min(560px, 100%);
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .search-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 2px solid var(--ink);
  }
  .search-glyph {
    font-size: 20px;
    line-height: 1;
  }
  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--mono);
    font-size: 16px;
    color: var(--ink);
  }
  .search-esc {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1.5px solid var(--line);
    background: var(--paper-2);
    color: var(--ink-40);
    padding: 2px 7px;
    cursor: pointer;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 6px;
    max-height: 46vh;
    overflow-y: auto;
  }
  .search-item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "group title"
      "group desc";
    column-gap: 12px;
    align-items: baseline;
    padding: 10px 12px;
    cursor: pointer;
    border: 2px solid transparent;
  }
  .search-item.on {
    background: var(--paper-2);
    border-color: var(--ink);
  }
  .search-group {
    grid-area: group;
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-40);
    min-width: 92px;
  }
  .search-title {
    grid-area: title;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .search-desc {
    grid-area: desc;
    font-size: 12.5px;
    color: var(--ink-60);
  }
  .search-empty {
    padding: 18px 12px;
    font-size: 13.5px;
    color: var(--ink-40);
  }
  .search-hint {
    display: flex;
    gap: 18px;
    padding: 8px 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-40);
  }
  .search-hint b {
    color: var(--ink);
    font-weight: 600;
  }
</style>
